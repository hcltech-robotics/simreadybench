FROM python:3.12-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PXR_WORK_THREAD_LIMIT=2
COPY simreadybench_eval-2.2.0-py3-none-any.whl /opt/wheels/simreadybench_eval-2.2.0-py3-none-any.whl
COPY feedback.requirements.txt /opt/locks/feedback.requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes --no-deps -r /opt/locks/feedback.requirements.txt && python -m pip install --no-cache-dir --no-deps '/opt/wheels/simreadybench_eval-2.2.0-py3-none-any.whl'
RUN mkdir -p /state && chmod 700 /state
USER 0
ENTRYPOINT ["python", "-m", "simready_eval.feedback", "serve", "--state", "/state", "--host", "0.0.0.0", "--port", "8080"]
